[9.717351, "o", "\u001b[36m\u001b[1m========================================== short test summary info ===========================================\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_api.py::\u001b[1mtest_live_http_versions_blocking_payload_and_metrics\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_bounds.py::\u001b[1mtest_worker_payload_cpu_and_queue_bounds\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_canary.py::\u001b[1mtest_canary_only_defect_aborts_and_confirmed_rollback_serves_stable\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_controller.py::\u001b[1mtest_controller_recovers_stages_and_promotes_once\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_controller.py::\u001b[1mtest_controller_rollback_independent_and_failure_is_honest\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_controller.py::\u001b[1mtest_failed_final_stage_rollback_halts_across_restart_until_recovery\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_controller.py::\u001b[1mtest_audit_failure_still_restores_and_requires_explicit_recovery\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_controller.py::\u001b[1mtest_unwritable_halt_latch_still_restores_and_halts_in_process\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_deadlines.py::\u001b[1mtest_control_characters_and_actual_queue_wait_are_measured\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_deadlines.py::\u001b[1mtest_expired_stage_never_promotes_old_samples\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_demo.py::\u001b[1mtest_bounded_demo_uses_real_processes_and_http\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_hardening.py::\u001b[1mtest_malformed_telemetry_is_inconclusive_not_a_crash\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_hardening.py::\u001b[1mtest_control_lock_has_deadline_and_records_failed_rollback\u001b[0m\r\n\u001b[32mPASSED\u001b[0m tests/test_lane_isolation.py::\u001b[1mtest_candidate_has_no_access_to_stable_worker_capacity\u001b[0m\r\n"]
